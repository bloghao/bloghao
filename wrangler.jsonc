// xwblog（基于博客号 BlogHao 二次开发）—— Cloudflare Workers 配置
// 本地 D1/R2 资源已创建：xwblog-db / xwblog-images，database_id 见下方
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xwblog",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // 静态资源目录（后台 SPA / 插件 / favicon），其余请求进入 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 主题 CSS 以文本形式打进 Worker，随页面内联输出（零额外请求）；
  // schema.sql 同为文本（仅演示站 chunk 引用，冷启动建表见 src/demo.ts）——同类型规则必须合并一条
  "rules": [{ "type": "Text", "globs": ["**/*.css", "**/*.sql"] }],

  // D1 数据库：xwblog-db（与原 bloghao-db 完全隔离）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xwblog-db",
      "database_id": "0e71821c-7eac-4713-8ba3-21af7cca0631"
    }
  ],

  // R2 存储桶（图床）：xwblog-images
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "xwblog-images" }],

  // 定时任务：每分钟扫描定时发布（scheduler.ts）；
  // "30 16 * * *" = 北京时间 00:30 自动备份 D1 → R2 backups/（30 份滚动）
  "triggers": { "crons": ["* * * * *", "30 16 * * *"] },


  "observability": { "enabled": true }
}
