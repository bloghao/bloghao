{
  "name": "bloghao",
  "version": "2.7.0",
  "private": true,
  "description": "博客号 BlogHao —— 轻写作博客系统，完全跑在 Cloudflare（Workers + D1 + R2）上",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:demo": "wrangler dev -c wrangler.demo.jsonc",
    "deploy": "wrangler deploy",
    "deploy:demo": "wrangler deploy -c wrangler.demo.jsonc",
    "deploy:site": "cd website && wrangler pages deploy public",
    "build:docs": "node website/build-docs.mjs",
    "build:release": "node scripts/build-release.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file schema.sql",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "jsqr": "^1.4.0",
    "marked": "^18.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "fsevents@2.3.3": true
  }
}
